# Copy this file to .env and update values for your environment

# Petstore API Configuration
# NOTE: trailing slash is required — Playwright joins paths via the URL spec,
# so a base without it (e.g. .../v2) drops its last segment.
API_BASE_URL=https://petstore.swagger.io/v2/

# UI Test Configuration (for future use)
BASE_URL=https://www.gametwist.com/en/

# Browser Configuration
HEADLESS=true
