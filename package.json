{
  "name": "greentube-assignment",
  "version": "1.0.0",
  "description": "Greentube QA Assignment - TypeScript, Playwright & Cucumber",
  "scripts": {
    "test": "cucumber-js --config cucumber.config.js",
    "test:api": "cucumber-js --config cucumber.config.js --tags @api",
    "test:smoke": "cucumber-js --config cucumber.config.js --tags @smoke",
    "test:playwright": "playwright test",
    "test:api:playwright": "playwright test src/steps/petstore.api.spec.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.29",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
